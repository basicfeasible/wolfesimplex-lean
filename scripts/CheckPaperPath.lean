      #[``WolfeSimplex.PaperPath.part_a, ``WolfeSimplex.PaperPath.part_b]),
    (``WolfeSimplex.PaperPath.part_d,
      #[``WolfeSimplex.PaperPath.part_a, ``WolfeSimplex.affine_min]),
    (``WolfeSimplex.Paper.theorem1,
      #[``WolfeSimplex.IntLP.atom_bitLength, ``WolfeSimplex.PaperPath.part_a,
        ``WolfeSimplex.PaperPath.part_b, ``WolfeSimplex.PaperPath.part_c,
        ``WolfeSimplex.PaperPath.part_d]),
    (``WolfeSimplex.Efficiency.project_correct, #[``WolfeSimplex.PaperPath.part_c]),
    (``WolfeSimplex.Efficiency.induce_correct, #[``WolfeSimplex.Efficiency.project_correct]),
    (``WolfeSimplex.Efficiency.polynomial_transfer,
      #[``WolfeSimplex.Efficiency.reduction_input_size,
        ``WolfeSimplex.Efficiency.induce_correct]),
    (``WolfeSimplex.Efficiency.strongly_polynomial_transfer,
      #[``WolfeSimplex.Efficiency.reduction_dimension,
        ``WolfeSimplex.Efficiency.reduction_input_size,
        ``WolfeSimplex.Efficiency.induce_correct]),
    (``WolfeSimplex.Efficiency.corollary1,
      #[``WolfeSimplex.Efficiency.polynomial_transfer,
        ``WolfeSimplex.Efficiency.strongly_polynomial_transfer]),
    (``WolfeSimplex.Efficiency.iteration_transfer,
      #[``WolfeSimplex.IntLP.partialRunHist_hat_iff]),
    (``WolfeSimplex.Efficiency.corollary1_iterations,
      #[``WolfeSimplex.Efficiency.iteration_transfer,
        ``WolfeSimplex.Efficiency.reduction_input_size,
        ``WolfeSimplex.Efficiency.reduction_dimension]),
    (``WolfeSimplex.Efficiency.corollary1_rule,
      #[``WolfeSimplex.Efficiency.inducedRule_total,
        ``WolfeSimplex.Efficiency.corollary1_iterations]),
