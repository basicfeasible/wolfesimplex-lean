    (``WolfeSimplex.Efficiency.MachineAlgorithm.corollary1,
      #[``WolfeSimplex.Efficiency.MachineAlgorithm.polynomial_transfer,
        ``WolfeSimplex.Efficiency.MachineAlgorithm.strongly_polynomial_transfer]),
    (``WolfeSimplex.Efficiency.MachineAlgorithm.certificate,
      #[``WolfeSimplex.Efficiency.reduction_input_executed,
        ``WolfeSimplex.Efficiency.MachineAlgorithm.executed,
        ``WolfeSimplex.Efficiency.MachineAlgorithm.corollary1]),
    (``WolfeSimplex.Execution.atom_certificate,
      #[``WolfeSimplex.Execution.atomCode_correct, ``WolfeSimplex.Execution.integerAtoms_correct,
        ``WolfeSimplex.Execution.atomCode_work,
        ``WolfeSimplex.Execution.atom_wordWidth, ``WolfeSimplex.Execution.atom_bitWork]),
    (``WolfeSimplex.Execution.shield_certificate,
      #[``WolfeSimplex.Execution.shieldCode_correct, ``WolfeSimplex.Execution.shieldCode_peak,
        ``WolfeSimplex.Execution.shieldCode_address, ``WolfeSimplex.Execution.preparation_bitWork]),
    (``WolfeSimplex.Execution.weighted_certificate,
