import WolfeSimplex
import Lean.Util.FoldConsts

/-!
Run with `lake env lean scripts/CheckPaperPath.lean`.
Check the constants actually used in proof terms, not just their docstrings.
These checks describe the high-level composition; they do not assert that every
low-level tactic or auxiliary argument is identical to the prose proof.
-/

open Lean Elab Command in
run_cmd do
  let checks : Array (Name × Array Name) := #[
    (``WolfeSimplex.IntLP.corral', #[``WolfeSimplex.IntLP.direction']),
    (``WolfeSimplex.PaperPath.part_a,
      #[``WolfeSimplex.hom, ``WolfeSimplex.corral, ``WolfeSimplex.bases_corrals]),
    (``WolfeSimplex.PaperPath.part_b, #[``WolfeSimplex.hom, ``WolfeSimplex.pivot]),
