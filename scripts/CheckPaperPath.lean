      #[``WolfeSimplex.PaperCorollary2.stretchedRate_add_two]),
    (``WolfeSimplex.PaperCorollary2.random_edge_table1,
      #[``WolfeSimplex.PaperCorollary2.random_families_exact,
        ``WolfeSimplex.PaperCorollary2.stretched_exponential_add_two]),
    (``WolfeSimplex.PaperCorollary2.random_bland_table1,
      #[``WolfeSimplex.PaperCorollary2.random_families_exact,
        ``WolfeSimplex.PaperCorollary2.stretched_exponential_add_two]),
    (``WolfeSimplex.PaperCorollary2.least_index_table1,
      #[``WolfeSimplex.PaperCorollary2.least_index,
        ``WolfeSimplex.PaperCorollary2.table1_least_index_count]),
    (``WolfeSimplex.PaperCorollary2.linopt_table1,
      #[``WolfeSimplex.km_linopt, ``WolfeSimplex.PaperCorollary2.table1_linopt_count]),
    (``WolfeSimplex.PaperCorollary2.MDPSource.integer_nondegenerate,
      #[``WolfeSimplex.LP.nondegenerate_of_columnOwners,
        ``WolfeSimplex.RatLP.integerize_nondegenerate]),
    (``WolfeSimplex.PaperCorollary2.MDPSource.output_size,
      #[``WolfeSimplex.Efficiency.pointSize_atoms,
        ``WolfeSimplex.PaperCorollary4.Resources.capped_inputSize]),
    (``WolfeSimplex.PaperCorollary2.MDPSource.constructionCost_bound,
      #[``WolfeSimplex.PaperCorollary4.Resources.binary_pipelines,
        ``WolfeSimplex.Execution.Support.bitWork]),
    (``WolfeSimplex.PaperCorollary2.MDPSource.computed_start,
      #[``WolfeSimplex.Execution.Support.correct]),
    (``WolfeSimplex.PaperCorollary2.mdp_family_polynomial,
      #[``WolfeSimplex.PaperCorollary2.MDPSource.constructionCost_bound,
        ``WolfeSimplex.PaperCorollary2.MDPSource.output_size]),
    (``WolfeSimplex.PaperCorollary2.random_edge_table1_mdp,
      #[``WolfeSimplex.PaperCorollary2.MDPSource.random_edge_expected,
        ``WolfeSimplex.PaperCorollary2.stretched_exponential_add_two,
        ``WolfeSimplex.PaperCorollary2.mdp_family_polynomial]),
    (``WolfeSimplex.PaperCorollary2.random_bland_table1_mdp,
      #[``WolfeSimplex.PaperCorollary2.MDPSource.random_bland_expected,
        ``WolfeSimplex.PaperCorollary2.stretched_exponential_add_two,
        ``WolfeSimplex.PaperCorollary2.mdp_family_polynomial]),
    (``WolfeSimplex.IntLP.partialRun_hat_of_nondegenerate,
      #[``WolfeSimplex.IntLP.thm_a_of_nondegenerate,
        ``WolfeSimplex.IntLP.thm_b_of_nondegenerate]),
    (``WolfeSimplex.IntLP.run_hat_of_nondegenerate,
      #[``WolfeSimplex.IntLP.partialRun_hat_of_nondegenerate]),
    (``WolfeSimplex.IntLP.cap_run_hat_iff,
      #[``WolfeSimplex.LP.transfer_run_from_iff]),
    (``WolfeSimplex.IntLP.capped_linopt_run_matches_of_unique,
      #[``WolfeSimplex.IntLP.cap_run_hat_iff,
        ``WolfeSimplex.IntLP.isNondegenerate_hat_cap,
        ``WolfeSimplex.IntLP.linopt_run_matches_of_unique]),
    (``WolfeSimplex.BoundedLP.standard_isBasis,
      #[``WolfeSimplex.BoundedLP.basis_card,
        ``WolfeSimplex.BoundedLP.standard_mulVec_eq_zero_iff]),
    (``WolfeSimplex.BoundedLP.standard_basicSol,
      #[``WolfeSimplex.BoundedLP.standard_isBasis,
        ``WolfeSimplex.BoundedLP.lift_feasible_iff]),
    (``WolfeSimplex.BoundedLP.standard_basicDir,
      #[``WolfeSimplex.BoundedLP.standard_isBasis,
        ``WolfeSimplex.BoundedLP.direction_null,
        ``WolfeSimplex.BoundedLP.liftDir_entering,
        ``WolfeSimplex.BoundedLP.liftDir_off_basis]),
    (``WolfeSimplex.BoundedLP.standard_dantzig_iff,
      #[``WolfeSimplex.BoundedLP.standard_improving_iff,
        ``WolfeSimplex.BoundedLP.standard_reducedCost,
        ``WolfeSimplex.BoundedLP.oriented_cost_eq_neg_abs]),
    (``WolfeSimplex.BoundedLP.standard_pivot,
      #[``WolfeSimplex.BoundedLP.standard_isLeavingLabel_iff,
        ``WolfeSimplex.BoundedLP.standard_feasibleBasis,
        ``WolfeSimplex.BoundedLP.basis_exchange]),
    (``WolfeSimplex.BoundedLP.standard_run,
      #[``WolfeSimplex.BoundedLP.standard_feasibleBasis,
        ``WolfeSimplex.BoundedLP.standard_dantzig_iff,
        ``WolfeSimplex.BoundedLP.standard_pivot,
        ``WolfeSimplex.BoundedLP.standard_improving_iff]),
    (``WolfeSimplex.RationalNetwork.count_transfer,
      #[``WolfeSimplex.FlowNetwork.RowDeletion.standard_run,
        ``WolfeSimplex.RatLP.integer_count_transfer]),
    (``WolfeSimplex.RatLP.integer_count_transfer,
      #[``WolfeSimplex.RatLP.integerize_run,
        ``WolfeSimplex.IntLP.capped_linopt_run_of_nondegenerate,
        ``WolfeSimplex.IntLP.capped_linopt_run_matches_of_unique]),
    (``WolfeSimplex.PaperCorollary4.QueryInput.integer_nondegenerate,
      #[``WolfeSimplex.LP.nondegenerate_of_columnOwners,
        ``WolfeSimplex.RatLP.integerize_nondegenerate]),
    (``WolfeSimplex.PaperCorollary4.QueryInput.trace,
      #[``WolfeSimplex.InitRuns.init_linopt_main,
        ``WolfeSimplex.IntLP.cap_run_hat_iff,
        ``WolfeSimplex.RatLP.integerize_run]),
    (``WolfeSimplex.PaperCorollary4.QueryInput.queries,
      #[``WolfeSimplex.PaperCorollary4.QueryInput.trace,
        ``WolfeSimplex.Wolfe.MajorCycle.label_eq_of_fresh]),
    (``WolfeSimplex.PaperCorollary4.QueryInstance.answer_transfer,
      #[``WolfeSimplex.PaperCorollary4.QueryInput.queries,
        ``WolfeSimplex.Wolfe.exists_index_run]),
    (``WolfeSimplex.PaperCorollary4.Resources.programs_correct,
      #[``WolfeSimplex.RatLP.Executed.run_correct,
        ``WolfeSimplex.Construction.Cap.run_correct,
        ``WolfeSimplex.Execution.atomCode_correct,
        ``WolfeSimplex.Execution.shieldCode_correct]),
    (``WolfeSimplex.PaperCorollary4.Resources.pipelines,
      #[``WolfeSimplex.PaperCorollary4.Resources.capped_inputSize,
        ``WolfeSimplex.PaperCorollary4.Resources.cap_bitWork,
        ``WolfeSimplex.Execution.atom_bitWork,
        ``WolfeSimplex.Execution.shield_certificate]),
    (``WolfeSimplex.RationalNetwork.preparation_certificate,
      #[``WolfeSimplex.Execution.Network.correct,
        ``WolfeSimplex.Execution.Network.mask_correct,
        ``WolfeSimplex.RationalNetwork.executedPreparationCost_bound]),
    (``WolfeSimplex.RationalNetwork.executedPreparationCost_bound,
      #[``WolfeSimplex.Execution.Network.code_bitWork,
        ``WolfeSimplex.Execution.Network.mask_bitWork]),
    (``WolfeSimplex.RationalNetwork.reductionCost_bound,
      #[``WolfeSimplex.RationalNetwork.executedPreparationCost_bound,
        ``WolfeSimplex.PaperCorollary4.Resources.pipelines]),
    (``WolfeSimplex.PaperCorollary4.NetworkInput.preprocessing_certificate,
      #[``WolfeSimplex.RationalNetwork.preparation_certificate,
        ``WolfeSimplex.PaperCorollary4.NetworkInput.reductionCost_bound]),
    (``WolfeSimplex.PaperCorollary4.corollary4_queries,
      #[``WolfeSimplex.PaperCorollary4.QueryInstance.answer_transfer,
        ``WolfeSimplex.PaperCorollary4.query_family_polynomial]),
    (``WolfeSimplex.PaperCorollary4.corollary4_count,
      #[``WolfeSimplex.PaperCorollary4.NetworkInput.count_transfer,
        ``WolfeSimplex.PaperCorollary4.count_family_polynomial]),
    (``WolfeSimplex.ExtendedNetwork.flow_lt_bound,
      #[``WolfeSimplex.FlowNetwork.flow_le_outward_supply,
        ``WolfeSimplex.FlowNetwork.flow_le_inward_supply,
        ``WolfeSimplex.ExtendedNetwork.supply_lt_bound]),
    (``WolfeSimplex.ExtendedNetwork.pivot_to_finite,
      #[``WolfeSimplex.ExtendedNetwork.flow_lt_bound,
        ``WolfeSimplex.ExtendedNetwork.residual_eq]),
    (``WolfeSimplex.ExtendedNetwork.run_to_finite,
      #[``WolfeSimplex.ExtendedNetwork.state_to_finite,
        ``WolfeSimplex.ExtendedNetwork.pivot_to_finite]),
    (``WolfeSimplex.Execution.InfiniteCapacity.correct,
      #[``WolfeSimplex.Execution.InfiniteCapacity.bound_correct]),
    (``WolfeSimplex.Execution.InfiniteCapacity.code_bitWork,
      #[``WolfeSimplex.Execution.InfiniteCapacity.code_work,
        ``WolfeSimplex.Execution.InfiniteCapacity.code_peak,
        ``WolfeSimplex.Execution.InfiniteCapacity.code_address]),
    (``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.normalized_execution,
      #[``WolfeSimplex.ExtendedNetwork.run_to_finite,
        ``WolfeSimplex.ExtendedNetwork.nondegenerate_to_finite]),
    (``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.normalize,
      #[``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.normalized_execution]),
    (``WolfeSimplex.ExtendedNetwork.finite_positive,
      #[``WolfeSimplex.ExtendedNetwork.bound_pos]),
    (``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.normalization_correct,
      #[``WolfeSimplex.Execution.InfiniteCapacity.correct]),
    (``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.construction_polynomial,
      #[``WolfeSimplex.ExtendedNetwork.finite_inputSize,
        ``WolfeSimplex.Execution.InfiniteCapacity.code_bitWork,
        ``WolfeSimplex.PaperCorollary4.NetworkInput.reductionCost_bound]),
    (``WolfeSimplex.PaperCorollary4.corollary4_count_extended,
      #[``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.count_transfer,
        ``WolfeSimplex.PaperCorollary4.ExtendedNetworkInput.construction_polynomial])]
  for (decl, required) in checks do
    let info ← getConstInfo decl
    let some proof := info.value? (allowOpaque := true) | throwError "No proof body for {decl}"
    let used := proof.getUsedConstants
    for dependency in required do
      unless used.contains dependency do
        throwError "{decl} does not use required paper step {dependency}"
    logInfo m!"Verified paper steps in {decl}"
  -- Follow project definitions reachable from the theorem TYPE, not its proof.
  -- This prevents helper predicates from silently enlarging the reading surface.
  let env ← getEnv
  let root ← getConstInfo ``WolfeSimplex.Paper.theorem1
  let allowed : Array Name := #[`WolfeSimplex.Defs.Simplex,
    `WolfeSimplex.Defs.Wolfe, `WolfeSimplex.Defs.Induced]
  let mut pending := root.type.getUsedConstants
  let mut seen : NameSet := {}
  while !pending.isEmpty do
    let name := pending.back!
    pending := pending.pop
    if seen.contains name then continue
    seen := seen.insert name
    if let some index := env.getModuleIdxFor? name then
      let owner := env.header.moduleNames[index]!
      if owner.toString.startsWith "WolfeSimplex." then
        unless allowed.contains owner do
          throwError "Theorem 1 statement reaches {name} from extra module {owner}"
        let info ← getConstInfo name
        pending := pending ++ info.type.getUsedConstants
        if let some value := info.value? then
          pending := pending ++ value.getUsedConstants
  logInfo "Verified Theorem 1 statement dependencies: only the three core definition modules"
